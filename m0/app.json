{
  "expo": {
    "name": "Andante M0 Spike",
    "slug": "andante-m0",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": {
      "package": "com.gitarialex.andantem0",
      "permissions": [
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "VIBRATE"
      ]
    },
    "plugins": [
      "expo-dev-client",
      "./plugins/withReleaseNoInternet"
    ]
  }
}
